<Window x:Class="Lab3.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Lab3"
        mc:Ignorable="d"
        Title="Lab3" Height="420" Width="1000"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <Grid Background="#1E1E1E" Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="2*"/>
        </Grid.ColumnDefinitions>

        <!-- Статистика игрока -->
        <StackPanel Grid.Column="2" Margin="10,0,10,0">
            <TextBlock Text="Level:" Foreground="#A0A0A0" FontSize="12" Margin="0,0,0,3"/>
            <TextBox Text="{Binding Player.Level, Mode=OneWay}" IsReadOnly="True" Background="#2D2D2D" Foreground="#E0E0E0" Padding="5" Margin="0,0,0,15" BorderBrush="#444444"/>

            <TextBlock Text="Players gold:" Foreground="#A0A0A0" FontSize="12" Margin="0,0,0,3"/>
            <TextBox Text="{Binding Player.Gold, Mode=OneWay}" IsReadOnly="True" Background="#2D2D2D" Foreground="#D4AF37" FontWeight="Bold" Padding="5" Margin="0,0,0,15" BorderBrush="#444444"/>

            <TextBlock Text="Players damage:" Foreground="#A0A0A0" FontSize="12" Margin="0,0,0,3"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" Text="{Binding Player.Damage, Mode=OneWay}" IsReadOnly="True" Background="#2D2D2D" Foreground="#E0E0E0" Padding="5" VerticalAlignment="Center" BorderBrush="#444444"/>
                <Button Grid.Column="1" Command="{Binding UpgradeDamageCommand}" Content="Upgrade" Margin="10,0,0,0" Padding="15,5" Height="30" Background="#8B0000" Foreground="White" FontWeight="Bold" VerticalAlignment="Center" BorderThickness="0"/>
            </Grid>
        </StackPanel>


        <!-- Блок текущего противника/персонажа -->
        <Border Grid.Column="0" BorderBrush="#444444" BorderThickness="2" Background="#2D2D2D" CornerRadius="8" Padding="15">
            <StackPanel>
                <TextBlock Text="Enemy name:" Foreground="#A0A0A0" FontSize="12" Margin="0,0,0,3"/>
                <TextBox Text="{Binding CurrentEnemy.Name, Mode=OneWay}" IsReadOnly="True" Background="#1E1E1E" Foreground="#FF6347" FontSize="16" FontWeight="Bold" Padding="5" Margin="0,0,0,15"/>

                <TextBlock Text="Enemy hit point:" Foreground="#A0A0A0" FontSize="12" Margin="0,0,0,3"/>
                <TextBox Text="{Binding CurrentEnemy.CurrentLife, Mode=OneWay}" IsReadOnly="True" Background="#1E1E1E" Foreground="#FF4500" FontSize="16" FontWeight="Bold" Padding="5" Margin="0,0,0,15"/>

                <TextBlock Text="Gold from enemy:" Foreground="#A0A0A0" FontSize="12" Margin="0,0,0,3"/>
                <TextBox Text="{Binding CurrentEnemy.RewardGold, Mode=OneWay}" IsReadOnly="True" Background="#1E1E1E" Foreground="#D4AF37" FontSize="16" FontWeight="Bold" Padding="5" Margin="0,0,0,5"/>
            </StackPanel>
        </Border>


        <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock Text="Click to deal damage:" Foreground="White" Margin="0,0,0,10" HorizontalAlignment="Center"/>
            <Button Command="{Binding HitEnemyCommand}" Width="110" Height="110" Background="#E1E1E1">
                <Grid>
                    <!-- Этот тег сам загрузит картинку из папки bin/Debug/Icons -->
                    <Image Source="{Binding CurrentEnemy.IconPath}" Stretch="Uniform" Margin="5"/>
                </Grid>
            </Button>
            <UniformGrid Columns="2" Width="110" Margin="0,10,0,0">
                <Button Content="Repeat" Command="{Binding RepeatEnemyCommand}" Padding="3"/>
                <Button Content="Next"  Command="{Binding NextEnemyCommand}" Padding="3"/>
            </UniformGrid>
        </StackPanel>

    </Grid>
</Window>
